# Resend — newsletter signup backend (https://resend.com)
# Form gracefully degrades to a generic error if these are unset.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# One Audience per locale, so future drips can be language-targeted.
RESEND_AUDIENCE_ID_ZH=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
RESEND_AUDIENCE_ID_EN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Separate audience for partner applications (reseller leads).
RESEND_AUDIENCE_ID_PARTNER=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
